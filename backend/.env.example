# OrderKoi backend environment — template.
# Copy to .env and fill in real values. Everything the app needs to
# send email lives here; changing the provider later means editing
# this file (or the docker-compose environment block) only.

# --- Email (SMTP) ---
# Gmail: smtp.gmail.com:587 + an App Password (not your login password)
#   create one at https://myaccount.google.com/apppasswords
# Brevo: smtp-relay.brevo.com:587 + SMTP key (sender must be verified)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=abinroy510@gmail.com
SMTP_PASSWORD=your-app-password-here
# Display name + address shown in the From header
EMAIL_FROM=OrderKoi <abinroy510@gmail.com>

# --- App ---
# Where the frontend is served — links inside emails (reset, verify,
# tracking) are built from this
FRONTEND_URL=http://localhost:5173

# --- Security (REQUIRED in production) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
# Comma-separated list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# development | test | production
ENVIRONMENT=development

# --- Database (Phase 8b: PostgreSQL) ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/orderkoi
