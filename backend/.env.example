# Copy this file to `.env` and adjust values.
# NEVER commit the real .env file — it holds secrets.

# development | production
ENVIRONMENT=development

# Long random string used to sign JWT tokens (Phase 1+).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# How long a login token stays valid (minutes). 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Business timezone — where "today" and "this month" start for sellers.
# Any IANA name: Asia/Dhaka, Asia/Kolkata, UTC, ...
APP_TIMEZONE=Asia/Dhaka

# Frontend URL — used to build links in emails (password reset)
FRONTEND_URL=http://localhost:5173

# Database
# Dev: SQLite (zero setup). Production: postgresql://user:pass@host/dbname
# DATABASE_URL=postgresql://...

# SMTP email — leave empty in development (emails print to the server log).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-login
# SMTP_PASSWORD=your-smtp-key
# EMAIL_FROM=OrderKoi <no-reply@yourdomain.com>
