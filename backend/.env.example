# OrderKoi backend environment — template.
# Copy to .env and fill in real values. Everything the app needs to
# send email lives here; changing the provider later means editing
# this file (or the docker-compose environment block) only.

# --- Email (SMTP) ---
# Where mail goes: auto | console | smtp   (default auto)
#   auto    — SMTP when SMTP_HOST is set below, else the console
#             backend (emails printed to this log instead of sent)
#   console — always log, never touch the network
#   smtp    — always send, even if SMTP_HOST is empty (fails loudly)
# Set console explicitly to keep a machine offline regardless of what
# the SMTP settings below say — an *empty* SMTP_HOST cannot do that,
# because an empty env var counts as "not set" and this file wins.
#EMAIL_BACKEND=auto
# Gmail: smtp.gmail.com:587 + an App Password (not your login password)
#   create one at https://myaccount.google.com/apppasswords
# Brevo: smtp-relay.brevo.com:587 + SMTP key (sender must be verified)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=abinroy510@gmail.com
SMTP_PASSWORD=your-app-password-here
# Display name + address shown in the From header
EMAIL_FROM=OrderKoi <abinroy510@gmail.com>

# --- App ---
# Where the frontend is served — links inside emails (reset, verify,
# tracking) are built from this
FRONTEND_URL=http://localhost:5173

# --- Pro pricing (taka) ---
# Change any of these + restart the backend, and every surface follows
# (Settings pricing cards, admin expected-payment checks, revenue
# stats) — the frontend fetches them live from GET /public/stores/pricing.
# Run an offer any time: no code change, no frontend rebuild.
PRO_PRICE_1M=350
PRO_PRICE_6M=1750
PRO_PRICE_12M=2900

# --- Business configuration (same live-config mechanism) ---
# Free plan: one-time lifetime order allowance
FREE_PLAN_ORDERS=15
# Where sellers send bKash payments for Pro (Settings instructions)
BKASH_NUMBER=01736060259
BKASH_TYPE=Personal
# Public contact address (Terms/Privacy pages)
SUPPORT_EMAIL=abinroy510@gmail.com

# --- Security (REQUIRED in production) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
# Browser origins allowed to call the API — a JSON array, NOT a
# comma-separated list (a bare "a.com,b.com" fails to parse and the
# app refuses to boot). "*" is rejected: the API sends credentials, so
# a wildcard would let any website call it as a signed-in user.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# development | test | production
ENVIRONMENT=development

# --- Operational tunables (all optional) ---
# Every one below has a built-in default in app/config.py, so leaving
# it out changes nothing. Uncomment to tune without touching code.
# An empty value counts as "not set".

#LOG_LEVEL=INFO
#ACCESS_TOKEN_EXPIRE_MINUTES=1440
#RESET_TOKEN_EXPIRE_MINUTES=30
#EMAIL_VERIFICATION_EXPIRE_MINUTES=1440

# Rate limits, per client IP: "<max> per <window seconds>". Raise the
# login limit where many users share one IP (carrier CGNAT).
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_LOGIN_MAX=10
#RATE_LIMIT_LOGIN_WINDOW=60
#RATE_LIMIT_SIGNUP_MAX=5
#RATE_LIMIT_SIGNUP_WINDOW=60
#RATE_LIMIT_FORGOT_PASSWORD_MAX=5
#RATE_LIMIT_FORGOT_PASSWORD_WINDOW=60
#RATE_LIMIT_RESEND_VERIFICATION_MAX=5
#RATE_LIMIT_RESEND_VERIFICATION_WINDOW=60
#RATE_LIMIT_TRACK_MAX=60
#RATE_LIMIT_TRACK_WINDOW=60
#RATE_LIMIT_PUBLIC_FORM_MAX=10
#RATE_LIMIT_PUBLIC_FORM_WINDOW=60
#RATE_LIMIT_PUBLIC_MAX=30
#RATE_LIMIT_PUBLIC_WINDOW=60

# Per-account login lockout
#LOGIN_MAX_FAILURES=5
#LOGIN_FAILURE_WINDOW_MINUTES=15
#LOGIN_LOCKOUT_MINUTES=15

# Database connection pool
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=10
#DB_POOL_RECYCLE_SECONDS=1800
#DB_POOL_TIMEOUT_SECONDS=30

# Email delivery
#EMAIL_WORKERS=4
#EMAIL_SEND_ATTEMPTS=3
#EMAIL_RETRY_DELAYS_SECONDS=[2,10]
#SMTP_TIMEOUT_SECONDS=10
# Log full email bodies on the console backend? Default: on in
# development, off elsewhere (bodies carry reset/verify links).
#EMAIL_CONSOLE_LOGS_BODY=false

# Response caps and input ceilings
#EXPORT_MAX_ROWS=10000
#ADMIN_EXPORT_MAX_ROWS=20000
#MAX_PAGE_SIZE=100
#MAX_ADMIN_PAGE_SIZE=200
#MAX_ITEM_PRICE=10000000
#MAX_ORDER_TOTAL=9999999999.99

# Serve /docs + /openapi.json? Default: on in development, off in
# production.
#ENABLE_API_DOCS=false

# --- Database (PostgreSQL) — REQUIRED ---
# Two ways to configure, in priority order:
#
# 1. A full connection URL (wins if set):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5433/orderkoi
#
# 2. Discrete parts — composed into the URL automatically, so changing
#    the user, password, host, port, or database name is just an .env
#    edit with no code change. One of the two must be set; the app
#    refuses to boot without a database.
#    NOTE: the local PostgreSQL 17 install listens on port 5433
#    (5432 is the older PG 15 install).
#    Tests run against PG_DATABASE=orderkoi_test (auto-created; needs
#    CREATEDB on the role, granted once).
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=orderkoi
PG_USER=orderkoi
PG_PASSWORD=
