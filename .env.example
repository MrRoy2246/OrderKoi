# OrderKoi deployment configuration — copy to .env (never commit .env).
# Read by docker-compose.yml; nothing here is baked into the images.
#
# Generate a SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- Database (the Postgres container) ---
POSTGRES_USER=orderkoi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=orderkoi

# --- Backups (the `backup` service) ---
# A containerised pg_dump runs on the database's own image, so the
# client version can never fall behind the server (a pg_dump older than
# the server refuses to dump it at all). Dumps land in
# ./backend/backups on the host, verified before being kept, pruned to
# the newest BACKUP_KEEP.
#
# Offsite is NOT automated here — a container cannot know where
# "offsite" is, and a backup that only lives on the machine it protects
# is not a backup. See the copy step in docs/DEPLOYMENT.md.
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=14

# Encrypted with AES-256 before they are written (BACKUP_ENCRYPTION=on
# by default) — a dump holds password hashes and every customer's name,
# phone and address, and the offsite copy is the whole point of it.
#
# REQUIRED while BACKUP_ENCRYPTION is on: the backup service refuses to
# start without it, and says so in the log. Long and random; generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# There is no recovery path for a lost passphrase. Keep a copy in your
# password manager and in whatever you use to bootstrap a new server —
# NOT on this machine and NOT in this file's git history.
#BACKUP_PASSPHRASE=
#BACKUP_ENCRYPTION=on
# PBKDF2 rounds used to derive the key. A restore must use the same
# value (it is not stored in the file), so change it only with the
# backups you are willing to re-take.
#BACKUP_PBKDF2_ITER=200000

# --- Security ---
# Fresh random value. The app refuses to boot with the default, or
# with anything shorter than 32 chars, in production.
# Rotating it logs out every session (JWTs are signed with it).
SECRET_KEY=change-me-64-hex-chars

# --- Deployment shape ---
# production enables the boot-time config validation
ENVIRONMENT=production

# Where the browser app is served — reset/verification links point here
# REQUIRED, and must NOT be localhost/127.0.0.1 in production: the app
# refuses to boot, because every emailed link would be dead on arrival.
FRONTEND_URL=https://orderkoi.example.com

# The API's public URL — baked into the frontend bundle at build time
VITE_API_URL=https://api.orderkoi.example.com

# JSON array: browser origins allowed to call the API (the FRONTEND_URL
# above; add a www variant if you use one)
CORS_ORIGINS=["https://orderkoi.example.com"]

# --- Business configuration ---
# All of this is served live at GET /public/stores/pricing, so changing
# any of it is an .env edit + `docker compose up -d` — no rebuild, no
# code change. The frontend fetches it at runtime.
#
# REQUIRED — the deployment refuses to start without them, so a live
# site can never advertise the developer's personal number/inbox.
BKASH_NUMBER=01XXXXXXXXX
BKASH_TYPE=Personal
SUPPORT_EMAIL=support@orderkoi.example.com
# Free plan: one-time lifetime order allowance
FREE_PLAN_ORDERS=15
# Pro prices in taka
PRO_PRICE_1M=350
PRO_PRICE_6M=1750
PRO_PRICE_12M=2900

# --- Email (SMTP) ---
# REQUIRED in production — the app refuses to boot with an empty
# SMTP_HOST, because login requires a verified email: without a mail
# path no user could ever verify, sign in, or reset a password.
# Empty SMTP_HOST = console backend (emails printed to the log only),
# which is what development and the test suite use.
# Gmail: smtp.gmail.com:587 + an App Password. Moving to a transactional
# service (Brevo/Resend) is planned.
#
# Leaving SMTP_HOST empty selects the console backend. EMAIL_BACKEND
# overrides that choice: auto (default) | console | smtp. Set it to
# console to stay offline regardless of the SMTP values above — note an
# *empty* SMTP_HOST cannot express that once a .env is present.
#EMAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=OrderKoi <no-reply@orderkoi.example.com>

# --- Operational tunables ---
# Optional. Every one of these has a built-in default (app/config.py),
# so leaving them out changes nothing. Uncomment only what you need to
# tune — that is the whole point: no code change required.

# Log verbosity: DEBUG | INFO | WARNING | ERROR
#LOG_LEVEL=INFO

# How long a login lasts before the user must sign in again (minutes)
#ACCESS_TOKEN_EXPIRE_MINUTES=1440
#RESET_TOKEN_EXPIRE_MINUTES=30
#EMAIL_VERIFICATION_EXPIRE_MINUTES=1440

# Rate limits, "<max> per <window seconds>", per client IP. Raise these
# if legitimate users share an IP — mobile carriers in Bangladesh put
# many subscribers behind one CGNAT address.
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_LOGIN_MAX=10
#RATE_LIMIT_LOGIN_WINDOW=60
#RATE_LIMIT_SIGNUP_MAX=5
#RATE_LIMIT_SIGNUP_WINDOW=60
#RATE_LIMIT_FORGOT_PASSWORD_MAX=5
#RATE_LIMIT_FORGOT_PASSWORD_WINDOW=60
#RATE_LIMIT_RESEND_VERIFICATION_MAX=5
#RATE_LIMIT_RESEND_VERIFICATION_WINDOW=60
#RATE_LIMIT_TRACK_MAX=60
#RATE_LIMIT_TRACK_WINDOW=60
#RATE_LIMIT_PUBLIC_FORM_MAX=10
#RATE_LIMIT_PUBLIC_FORM_WINDOW=60
#RATE_LIMIT_PUBLIC_MAX=30
#RATE_LIMIT_PUBLIC_WINDOW=60

# Per-account lockout after repeated wrong passwords
#LOGIN_MAX_FAILURES=5
#LOGIN_FAILURE_WINDOW_MINUTES=15
#LOGIN_LOCKOUT_MINUTES=15

# Database connection pool — size to cover the sync route threadpool
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=10
#DB_POOL_RECYCLE_SECONDS=1800
#DB_POOL_TIMEOUT_SECONDS=30

# Email delivery
#EMAIL_WORKERS=4
#EMAIL_SEND_ATTEMPTS=3
#EMAIL_RETRY_DELAYS_SECONDS=[2,10]
#SMTP_TIMEOUT_SECONDS=10
# Log full email bodies on the console backend? Never in production —
# bodies carry password-reset and verification links. Default: on in
# development, off everywhere else.
#EMAIL_CONSOLE_LOGS_BODY=false

# Response caps and input ceilings
#EXPORT_MAX_ROWS=10000
#ADMIN_EXPORT_MAX_ROWS=20000
#MAX_PAGE_SIZE=100
#MAX_ADMIN_PAGE_SIZE=200
#MAX_ITEM_PRICE=10000000
#MAX_ORDER_TOTAL=9999999999.99

# Serve /docs + /openapi.json? Default: on in development, OFF in
# production (an open /docs advertises every admin route).
#ENABLE_API_DOCS=false

# --- Caddy edge proxy (only needed with `--profile edge`) ---
# NOTE: compose substitutes the whole file before it filters by
# profile, so these three must still be *set* even for a deployment
# that never runs Caddy — otherwise `docker compose up` aborts on a
# "required variable is missing" error for a service you aren't using.
# Their values are simply ignored in that case.
SITE_DOMAIN=orderkoi.example.com
API_DOMAIN=api.orderkoi.example.com
ACME_EMAIL=admin@orderkoi.example.com
# HSTS max-age in seconds (default 1 year). includeSubDomains is set in
# the Caddyfile — every subdomain of the apex must then serve HTTPS.
#HSTS_MAX_AGE=31536000

# --- Proxy trust (advanced) ---
# Which peers' X-Forwarded-For the API trusts. "*" is safe only because
# Caddy sets that header and the API port is never published publicly.
# Pin this to the compose network CIDR (e.g. 172.28.0.0/24) before
# putting a CDN in front or exposing port 8000.
#FORWARDED_ALLOW_IPS=*
