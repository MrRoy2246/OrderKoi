# =====================================================================
#  OrderKoi — environment template.
#
#  Copy to .env at the repo root and fill in the values:
#
#      cp .env.example .env
#
#  There is exactly ONE env file in this project, at the root. The
#  backend loads it by absolute path, Vite reads VITE_* from it, and
#  docker-compose.yml substitutes ${VAR} from it. Nothing else needs a
#  copy, and .env is gitignored — never commit it.
#
#  This file is safe to commit: placeholder values only, no secrets.
#
#  Full reference — what each variable does, its default, and what
#  changing it affects:  docs/ENVIRONMENT.md
# =====================================================================


# ---------------------------------------------------------------------
#  DATABASE
#
#  PG_*        the app running on the HOST (local development, alembic,
#              pytest, scripts/). Point at your local PostgreSQL.
#  POSTGRES_*  the DATABASE CONTAINER. The postgres image creates the
#              role and database from these on first boot.
#
#  Inside the compose network the app is always given PG_HOST=db and
#  PG_PORT=5432 regardless of the values here, so only the user,
#  password and database name need to match between the two sets.
# ---------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=orderkoi
PG_USER=orderkoi
PG_PASSWORD=change-me-strong-password

POSTGRES_USER=orderkoi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=orderkoi

# A single full connection string instead of the five parts above.
# Overrides every PG_*. Leave empty for the composed form.
DATABASE_URL=

# ---------------------------------------------------------------------
#  SECURITY
#
#  SECRET_KEY signs every JWT — rotating it signs out every user on
#  every device. REQUIRED. Production refuses to boot on the default
#  value or anything under 32 characters.
#
#      python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------
SECRET_KEY=change-me-64-hex-chars

# ---------------------------------------------------------------------
#  APP
#
#  ENVIRONMENT: development | test | production. Validated at boot.
#  production turns on the safety checks below and switches /docs off.
# ---------------------------------------------------------------------
ENVIRONMENT=production
APP_TIMEZONE=Asia/Dhaka

# Where the browser app is served. REQUIRED, and must NOT be
# localhost in production — the app refuses to boot, because every
# emailed reset and verification link would be dead on arrival.
FRONTEND_URL=https://orderkoi.example.com

# The API's public origin. Baked into the frontend bundle at BUILD
# time (a build without it is refused), so changing it means a rebuild.
VITE_API_URL=https://api.orderkoi.example.com

# Browser origins allowed to call the API — a JSON array. Use the
# FRONTEND_URL above; add a www variant if you serve one. '*' is
# rejected at boot (the API sends credentials).
CORS_ORIGINS=["https://orderkoi.example.com"]


# ---------------------------------------------------------------------
#  BUSINESS CONFIGURATION
#
#  Served live at GET /public/stores/pricing and read per-request, so
#  changing any of it is an .env edit + `docker compose up -d`. No
#  rebuild, no code change — the frontend fetches it at runtime.
#
#  BKASH_NUMBER and SUPPORT_EMAIL are REQUIRED in production: without
#  them a live site would advertise the developer's personal number and
#  inbox to customers.
# ---------------------------------------------------------------------
BKASH_NUMBER=01XXXXXXXXX
BKASH_TYPE=Personal
SUPPORT_EMAIL=support@orderkoi.example.com
# Free plan: a one-time lifetime order allowance, not monthly.
FREE_PLAN_ORDERS=15
# Pro prices in taka, per duration.
PRO_PRICE_1M=350
PRO_PRICE_6M=1750
PRO_PRICE_12M=2900


# ---------------------------------------------------------------------
#  EMAIL (SMTP)
#
#  REQUIRED in production — the app refuses to boot with an empty
#  SMTP_HOST, because login needs a verified email: with no mail path
#  nobody could ever verify, sign in, or reset a password.
#
#  Gmail: smtp.gmail.com:587 with an App Password (not the account
#  password) — https://myaccount.google.com/apppasswords
#  A transactional service (Brevo/Resend) is the planned move: the
#  personal Gmail app password is capped at ~500 messages/day.
#
#  EMAIL_BACKEND overrides the SMTP/console choice:
#    auto (default)  SMTP when SMTP_HOST is set, else the console
#    console         always log the email, never touch the network
#    smtp            always send; an empty SMTP_HOST is an error
#  "console" must be set explicitly to stay offline once a real
#  SMTP_HOST is present — an empty SMTP_HOST cannot express it.
# ---------------------------------------------------------------------
EMAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=OrderKoi <no-reply@orderkoi.example.com>


# =====================================================================
#  OPERATIONAL TUNABLES
#
#  Optional. Every one has a built-in default (app/config.py), and
#  leaving it out changes nothing — an empty value counts as "not set".
#  Uncomment only what you need to tune. That is the whole point: no
#  code change, no rebuild.
# =====================================================================

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
#LOG_LEVEL=INFO

# --- Session and token lifetimes (minutes) ---
#ACCESS_TOKEN_EXPIRE_MINUTES=1440
#RESET_TOKEN_EXPIRE_MINUTES=30
#EMAIL_VERIFICATION_EXPIRE_MINUTES=1440

# --- Rate limiting: per-IP sliding window, "<max> per <window seconds>" ---
# Raise these where many real users share one IP — mobile carriers in
# Bangladesh put many subscribers behind a single CGNAT address.
# RATE_LIMIT_ENABLED=false disables the limiter entirely: load testing
# only, never production.
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_LOGIN_MAX=10
#RATE_LIMIT_LOGIN_WINDOW=60
#RATE_LIMIT_SIGNUP_MAX=5
#RATE_LIMIT_SIGNUP_WINDOW=60
#RATE_LIMIT_FORGOT_PASSWORD_MAX=5
#RATE_LIMIT_FORGOT_PASSWORD_WINDOW=60
#RATE_LIMIT_RESEND_VERIFICATION_MAX=5
#RATE_LIMIT_RESEND_VERIFICATION_WINDOW=60
#RATE_LIMIT_TRACK_MAX=60
#RATE_LIMIT_TRACK_WINDOW=60
#RATE_LIMIT_PUBLIC_FORM_MAX=10
#RATE_LIMIT_PUBLIC_FORM_WINDOW=60
#RATE_LIMIT_PUBLIC_MAX=30
#RATE_LIMIT_PUBLIC_WINDOW=60

# --- Per-account login lockout ---
# Follows the account rather than the IP, so a proxy-rotating attacker
# is still stopped. Wrong passwords before lockout, over what window,
# and how long the lock lasts.
#LOGIN_MAX_FAILURES=5
#LOGIN_FAILURE_WINDOW_MINUTES=15
#LOGIN_LOCKOUT_MINUTES=15

# --- Database connection pool ---
# Size to cover the sync route threadpool (40) so requests never wait
# on a checkout.
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=10
#DB_POOL_RECYCLE_SECONDS=1800
#DB_POOL_TIMEOUT_SECONDS=30

# --- Email delivery ---
#EMAIL_WORKERS=4
#EMAIL_SEND_ATTEMPTS=3
# JSON array of backoff seconds between attempts.
#EMAIL_RETRY_DELAYS_SECONDS=[2,10]
#SMTP_TIMEOUT_SECONDS=10

# --- Request / response limits ---
# Row caps on the CSV exports (seller, then admin).
#EXPORT_MAX_ROWS=10000
#ADMIN_EXPORT_MAX_ROWS=20000
# Page-size ceilings the list endpoints accept — asking for more is a
# 422. The UI builds its page-size options from these.
#MAX_PAGE_SIZE=100
#MAX_ADMIN_PAGE_SIZE=200
# Ceilings on one item's unit price and on a computed order total.
#MAX_ITEM_PRICE=10000000
#MAX_ORDER_TOTAL=9999999999.99

# ---------------------------------------------------------------------
#  AUTOMATIC-BY-DEFAULT — unset on purpose
#
#  Each of these has a meaningful "choose for me" behaviour; any value
#  written here pins it.
# ---------------------------------------------------------------------

# /docs, /redoc and /openapi.json. Unset = on in development and test,
# OFF in production (an open /docs advertises every admin route).
#ENABLE_API_DOCS=

# Full email bodies in the console log? Unset = on in development, off
# everywhere else. Never in production — bodies carry reset links.
#EMAIL_CONSOLE_LOGS_BODY=

# API identity strings — cosmetic, leave them.
#APP_NAME=OrderKoi API
#API_VERSION=1.0.0

# JWT signing algorithm. Pinned by the verifier; changing it
# invalidates every issued token and locks out every user.
#JWT_ALGORITHM=HS256


# =====================================================================
#  DOCKER COMPOSE ONLY
#
#  Read by docker-compose.yml, not by the app on the host.
# =====================================================================

# --- Encrypted database backups (the `backup` service) ---
# A containerised pg_dump runs on the database's own image, so the
# client version can never fall behind the server. Dumps land in
# ./backend/backups on the host, verified before being kept, pruned to
# the newest BACKUP_KEEP.
#
# Offsite is NOT automated here: a container cannot know where
# "offsite" is, and a backup that only lives on the machine it
# protects is not a backup. See the copy step in docs/DEPLOYMENT.md.
#
# Encrypted with AES-256 before being written, because a dump holds
# password hashes and every customer's name, phone and address.
#
# REQUIRED while BACKUP_ENCRYPTION is on — the service refuses to start
# without it. There is no recovery path for a lost passphrase: keep it
# in a password manager and in whatever bootstraps a new server, NOT on
# this machine and NOT in this file's git history.
#
#      python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# A restore must use the same BACKUP_PBKDF2_ITER — it is not stored in
# the dump — so change it only with backups you will retake.
#BACKUP_PASSPHRASE=
#BACKUP_ENCRYPTION=on
#BACKUP_PBKDF2_ITER=200000
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=14

# --- Caddy edge proxy (only with `--profile edge`) ---
# NOTE: compose substitutes the whole file before it filters by
# profile, so these must still be *set* even for a deployment that
# never runs Caddy — otherwise `docker compose up` aborts on a
# "required variable is missing" error for a service you aren't using.
# Their values are simply ignored in that case.
SITE_DOMAIN=orderkoi.example.com
API_DOMAIN=api.orderkoi.example.com
ACME_EMAIL=admin@orderkoi.example.com
# HSTS max-age in seconds (default 1 year). includeSubDomains is set in
# the Caddyfile — every subdomain of the apex must then serve HTTPS.
#HSTS_MAX_AGE=31536000

# --- Proxy trust (advanced) ---
# Which peers' X-Forwarded-For the API trusts. "*" is safe only because
# Caddy sets that header and the API port is never published publicly.
# Pin this to the compose network CIDR (e.g. 172.28.0.0/24) before
# putting a CDN in front or exposing port 8000.
#FORWARDED_ALLOW_IPS=*
